package com.runner.game;

import com.badlogic.gdx.ApplicationAdapter;
import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.Input;
import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.GL20;
import com.badlogic.gdx.graphics.OrthographicCamera;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;
import com.badlogic.gdx.math.Rectangle;
import com.badlogic.gdx.utils.Array;

import java.util.Iterator;
import java.util.Random;

public class RunnerGame extends ApplicationAdapter {
    OrthographicCamera camera;
    ShapeRenderer shapeRenderer;

    Rectangle player;
    float playerVelocityY = 0;
    boolean isJumping = false;

    Array<Rectangle> obstacles;
    Random random;

    int score = 0;
    float obstacleTimer = 0;

    @Override
    public void create() {
        camera = new OrthographicCamera();
        camera.setToOrtho(false, 800, 480);

        shapeRenderer = new ShapeRenderer();

        player = new Rectangle(100, 80, 40, 40);

        obstacles = new Array<>();
        random = new Random();
    }

    @Override
    public void render() {
        Gdx.gl.glClear(GL20.GL_COLOR_BUFFER_BIT);
        camera.update();
        shapeRenderer.setProjectionMatrix(camera.combined);

        // Background
        Gdx.gl.glClearColor(0.2f, 0.6f, 1, 1);

        shapeRenderer.begin(ShapeRenderer.ShapeType.Filled);

        // Draw player
        shapeRenderer.setColor(Color.RED);
        shapeRenderer.rect(player.x, player.y, player.width, player.height);

        // Player jump logic
        if (Gdx.input.isKeyPressed(Input.Keys.SPACE) && !isJumping) {
            playerVelocityY = 300; // Jump strength
            isJumping = true;
        }

        player.y += playerVelocityY * Gdx.graphics.getDeltaTime();
        playerVelocityY -= 500 * Gdx.graphics.getDeltaTime(); // Gravity

        if (player.y <= 80) { // Ground
            player.y = 80;
            isJumping = false;
        }

        // Spawn obstacles
        obstacleTimer += Gdx.graphics.getDeltaTime();
        if (obstacleTimer > 1.5) {
            Rectangle obstacle = new Rectangle(800, 80, 40, 40);
            obstacles.add(obstacle);
            obstacleTimer = 0;
        }

        // Draw & move obstacles
        shapeRenderer.setColor(Color.BLACK);
        Iterator<Rectangle> iter = obstacles.iterator();
        while (iter.hasNext()) {
            Rectangle obs = iter.next();
            obs.x -= 200 * Gdx.graphics.getDeltaTime();
            shapeRenderer.rect(obs.x, obs.y, obs.width, obs.height);

            if (obs.overlaps(player)) {
                System.out.println("Game Over! Final Score: " + score);
                Gdx.app.exit();
            }

            if (obs.x + obs.width < 0) {
                iter.remove();
                score++;
                System.out.println("Score: " + score);
            }
        }

        shapeRenderer.end();
    }

    @Override
    public void dispose() {
        shapeRenderer.dispose();
    }
}
