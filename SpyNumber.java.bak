import java.util.Scanner;
class  SpyNumber
{
	public static void main(String[] args) 
	{   Scanner sc = new Scanner(System.in);
		System.out.println("Enter a Number:");
		int num = sc.nextInt();
		int sum = 0;
		int product = 1;
		while(num!=0)
		{
			int ld = num%10;
			sum = sum+ld;
			product = product*ld;
			num = num/10;
	    }
		if (sum==product)
		{
			System.out.println("spy number");
		}
		else
		{
			System.out.println("Not spy");

		}
	}
}
