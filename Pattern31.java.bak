class Pattern31 
{
	public static void main(String[] args) 
	{   
		int star = 1;
		int space = 2;
		for (int i=1;i<=14 ;i++)
		{
			for (int a=1;a<=2 ;a++ )
			{
				System.out.print(" *  ");
			}
			for (int b=1;b<=2 ;b++ )
			{
				System.out.print("  ");
			}
			star=1;
			space--;
			System.out.println(" ");
		}
	}
}
