import java.util.Scanner;
class  TempColdOrHot
{
	public static void main(String[] args) 
	{   Scanner sc = new Scanner(System.in);
		System.out.println("Enter a temprature:");
		int temp = sc.nextInt();
		if (temp<10)
		{
			System.out.println("The temprature is Cool");
		}
		else if (temp>=10 && temp=<20)
		{
			System.out.println("The temprature is cold");

		}
		else if (temp>=20 && temp=<30)
		{
			System.out.println("the temprature is warm");
		}
		else
	    {
			System.out.println("The temprature is Hot");
		}










	}
}
